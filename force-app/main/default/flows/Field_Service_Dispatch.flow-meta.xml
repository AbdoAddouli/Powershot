<?xml version="1.0" encoding="UTF-8"?>
<Flow xmlns="http://soap.sforce.com/2006/04/metadata">
    <apiVersion>66.0</apiVersion>
    <description>Check PTW requirements on Work Order creation</description>
    <label>Field Service Dispatch</label>
    <processMetadataValues>
        <name>BuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processType>AutoLaunchedFlow</processType>
    <recordLookups>
        <name>Verify_PTW_Status</name>
        <label>Verify PTW Status</label>
        <locationX>200</locationX>
        <locationY>200</locationY>
        <assignNullValuesIfNoRecordsFound>true</assignNullValuesIfNoRecordsFound>
        <connector>
            <targetReference>Check_PTW_Valid</targetReference>
        </connector>
        <filterLogic>AND</filterLogic>
        <filters>
            <field>Id</field>
            <operator>EqualTo</operator>
            <value>
                <elementReference>$Record.Permit_to_Work__c</elementReference>
            </value>
        </filters>
        <filters>
            <field>Status__c</field>
            <operator>EqualTo</operator>
            <value>
                <stringValue>Issued</stringValue>
            </value>
        </filters>
        <object>Permit_to_Work__c</object>
        <queriedFields>Id</queriedFields>
        <getFirstRecordOnly>true</getFirstRecordOnly>
        <storeOutputAutomatically>true</storeOutputAutomatically>
    </recordLookups>
    <decisions>
        <name>Check_PTW_Valid</name>
        <label>Check PTW Valid</label>
        <locationX>400</locationX>
        <locationY>200</locationY>
        <defaultConnector>
            <targetReference>Create_PTW_Task</targetReference>
        </defaultConnector>
        <defaultConnectorLabel>PTW Not Issued</defaultConnectorLabel>
        <rules>
            <name>PTW_Valid</name>
            <conditionLogic>AND</conditionLogic>
            <conditions>
                <leftValueReference>Verify_PTW_Status</leftValueReference>
                <operator>IsNull</operator>
                <rightValue>
                    <booleanValue>false</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Create_Dispatch_Task</targetReference>
            </connector>
            <label>Valid PTW</label>
        </rules>
        <rules>
            <name>No_PTW_Needed</name>
            <conditionLogic>AND</conditionLogic>
            <conditions>
                <leftValueReference>$Record.Permit_to_Work__c</leftValueReference>
                <operator>IsNull</operator>
                <rightValue>
                    <booleanValue>true</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Create_Dispatch_Task</targetReference>
            </connector>
            <label>No PTW Needed</label>
        </rules>
    </decisions>
    <recordCreates>
        <name>Create_PTW_Task</name>
        <label>Create PTW Task</label>
        <locationX>600</locationX>
        <locationY>100</locationY>
        <inputAssignments>
            <field>Subject</field>
            <value>
                <stringValue>Valid PTW required before dispatch</stringValue>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>Status</field>
            <value>
                <stringValue>Not Started</stringValue>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>Priority</field>
            <value>
                <stringValue>High</stringValue>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>WhatId</field>
            <value>
                <elementReference>$Record.Permit_to_Work__c</elementReference>
            </value>
        </inputAssignments>
        <object>Task</object>
        <storeOutputAutomatically>true</storeOutputAutomatically>
    </recordCreates>
    <recordCreates>
        <name>Create_Dispatch_Task</name>
        <label>Create Dispatch Task</label>
        <locationX>600</locationX>
        <locationY>300</locationY>
        <inputAssignments>
            <field>Subject</field>
            <value>
                <stringValue>Dispatch crew for Work Order</stringValue>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>Status</field>
            <value>
                <stringValue>Not Started</stringValue>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>Priority</field>
            <value>
                <stringValue>Normal</stringValue>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>WhatId</field>
            <value>
                <elementReference>$Record.Id</elementReference>
            </value>
        </inputAssignments>
        <object>Task</object>
        <storeOutputAutomatically>true</storeOutputAutomatically>
    </recordCreates>
    <start>
        <locationX>50</locationX>
        <locationY>0</locationY>
        <connector>
            <targetReference>Verify_PTW_Status</targetReference>
        </connector>
        <object>WorkOrder</object>
        <recordTriggerType>Create</recordTriggerType>
        <triggerType>RecordAfterSave</triggerType>
    </start>
    <status>Active</status>
</Flow>
