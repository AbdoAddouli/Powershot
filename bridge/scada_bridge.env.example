# SCADA bridge configuration template.
# Copy this file to `scada_bridge.env` (same directory) and fill in the values.
# NEVER commit `scada_bridge.env` — it contains secrets.

# Set by you to match SCADA_Config__c.Shared_Secret__c in the "ouil gas" org.
SCADA_SHARED_SECRET=

# Full REST endpoint (see SCADA_PI_BRIDGE.md).
SCADA_ENDPOINT=https://orgfarm-4d94271bcc-dev-ed.develop.my.salesforce.com/services/apexrest/api/scada/measurements

# Salesforce OAuth session/bearer token (required - the org has no public guest site).
# Leave blank to have sender.ps1 fetch one from 'sf org display' for testing.
SCADA_ACCESS_TOKEN=

# PI Web API connection (used by bridge_poc.py only).
PIWEBAPI_URL=
PIWEBAPI_USER=
PIWEBAPI_PASS=
